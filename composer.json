{
  "name": "kununu/testing-bundle",
  "description": "Testing made easy by providing helper classes and fixtures loading",
  "license": "MIT",
  "type": "symfony-bundle",
  "keywords": [
    "tests",
    "symfony",
    "fixtures"
  ],
  "authors": [
    {
      "name": "Hugo Gonçalves",
      "email": "hugo.goncalves@kununu.com"
    },
    {
      "name": "João Alves",
      "email": "joao.alves@kununu.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-filter": "*",
    "kununu/collections": "^7.0 || ^8.0",
    "kununu/data-fixtures": "^15.1",
    "symfony/config": "^6.4 || ^7.4",
    "symfony/dependency-injection": "^6.4 || ^7.4",
    "symfony/framework-bundle": "^6.4 || ^7.4",
    "symfony/http-kernel": "^6.4 || ^7.4"
  },
  "require-dev": {
    "ext-json": "*",
    "ext-pdo": "*",
    "aws/aws-sdk-php": "^3.173",
    "doctrine/dbal": "^3.10 || ^4.4",
    "doctrine/doctrine-bundle": "~2.15.0",
    "doctrine/doctrine-migrations-bundle": "^3.7",
    "doctrine/orm": "^3.6",
    "elasticsearch/elasticsearch": "^7.10",
    "kununu/code-tools": "^5.2",
    "matthiasnoback/symfony-dependency-injection-test": "^6.2",
    "nyholm/psr7": "^1.8",
    "opensearch-project/opensearch-php": "^2.5",
    "phpunit/phpunit": "^13.3",
    "psr/cache": "^2.0",
    "shipmonk/composer-dependency-analyser": "^1.8",
    "symfony/browser-kit": "^6.4 || ^7.4",
    "symfony/dotenv": "^6.4 || ^7.4",
    "symfony/http-client": "^6.4 || ^7.4",
    "symfony/http-foundation": "^6.4 || ^7.4"
  },
  "suggest": {
    "ext-pdo_mysql": "To run Integration Tests.",
    "aws/aws-sdk-php": "To use DynamoDB fixtures.",
    "doctrine/doctrine-bundle": "To run Integration Tests.",
    "elasticsearch/elasticsearch": "To run Integration Tests.",
    "opensearch-project/opensearch-php": "To run Integration Tests.",
    "psr/cache": "To run Integration Tests.",
    "symfony/http-client": "To run Integration Tests.",
    "symfony/http-foundation": "To run Integration Tests."
  },
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "Kununu\\TestingBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kununu\\TestingBundle\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "kununu/code-tools": true,
      "php-http/discovery": true
    },
    "sort-packages": true
  },
  "scripts": {
    "ci": [
      "print-section 'Removing integration tests caches'",
      "rm -rf tests/App/var/*",
      "print-section 'Security Audit'",
      "composer audit --abandoned=report",
      "print-section 'Dependency Analyser'",
      "composer-dependency-analyser",
      "print-section 'Composer Require Checker'",
      "@require-checker",
      "print-section 'Composer Normalize'",
      "@normalize-check",
      "print-section 'PHP CS Fixer'",
      "@cs",
      "print-section 'PHP CodeSniffer'",
      "@sniffer",
      "print-section 'Rector'",
      "@rector",
      "print-section 'PHPStan'",
      "@phpstan",
      "print-section 'Tests & Coverage'",
      "@test-coverage",
      "print-section 'Coverage Check'",
      "@coverage-check"
    ],
    "coverage-check": "coverage-check tests/.results/tests-cobertura.xml 95",
    "cs": [
      "rm -rf tests/App/var/*",
      "composer kununu:cs-fixer src/ tests/"
    ],
    "integration": [
      "rm -rf tests/App/var/*",
      "tests/App/bin/setup_databases.sh test",
      "phpunit --testsuite Integration --testdox --testdox-summary --no-coverage --no-logging"
    ],
    "integration-coverage": [
      "rm -rf tests/App/var/*",
      "tests/App/bin/setup_databases.sh test",
      "@putenv XDEBUG_MODE=coverage",
      "@php -d zend.assertions=1 vendor/bin/phpunit --testsuite Integration --testdox --testdox-summary --log-junit tests/.results/integration-junit.xml --coverage-clover tests/.results/coverage-integration --coverage-html tests/.results/Integration/"
    ],
    "normalize-check": [
      "@tool:composer-normalize",
      "@php tools/composer-normalize.phar --dry-run --indent-size 2 --indent-style space --no-check-lock --no-update-lock"
    ],
    "normalize-fix": [
      "@tool:composer-normalize",
      "@php tools/composer-normalize.phar --indent-size 2 --indent-style space --no-check-lock --no-update-lock"
    ],
    "phpstan": "phpstan",
    "rector": "rector process --dry-run --config rector-ci.php src/ tests/",
    "rector-fix": "rector process --config rector-ci.php src/ tests/",
    "require-checker": [
      "@tool:composer-require-checker",
      "@putenv XDEBUG_MODE=off",
      "@php tools/composer-require-checker.phar check composer.json"
    ],
    "sniffer": [
      "rm -rf tests/App/var/*",
      "phpcs"
    ],
    "sniffer-fix": [
      "rm -rf tests/App/var/*",
      "phpcbf"
    ],
    "test": [
      "rm -rf tests/App/var/*",
      "tests/App/bin/setup_databases.sh test",
      "phpunit --testsuite Unit,Integration --testdox --testdox-summary --no-coverage --no-logging"
    ],
    "test-coverage": [
      "rm -rf tests/App/var/*",
      "tests/App/bin/setup_databases.sh test",
      "@putenv XDEBUG_MODE=coverage",
      "@php -d zend.assertions=1 vendor/bin/phpunit --testsuite Unit,Integration --testdox --testdox-summary --log-junit tests/.results/tests-junit.xml --coverage-clover tests/.results/tests-clover.xml --coverage-cobertura tests/.results/tests-cobertura.xml --coverage-html tests/.results/html/"
    ],
    "tool:composer-normalize": "download-phar composer-normalize ergebnis/composer-normalize composer-normalize.phar",
    "tool:composer-require-checker": "download-phar composer-require-checker maglnet/ComposerRequireChecker composer-require-checker.phar",
    "unit": "phpunit --testsuite Unit --testdox --testdox-summary --no-coverage --no-logging",
    "unit-coverage": [
      "@putenv XDEBUG_MODE=coverage",
      "@php -d zend.assertions=1 vendor/bin/phpunit --testsuite Unit --testdox --testdox-summary --log-junit tests/.results/unit-junit.xml --coverage-clover tests/.results/coverage-unit.xml --coverage-html tests/.results/Unit/"
    ]
  },
  "scripts-descriptions": {
    "ci": "Run all CI checks",
    "cs": "Run PHP CS Fixer with kununu code standards",
    "integration": "Run all integration tests",
    "integration-coverage": "Run all integration tests with coverage report",
    "normalize-check": "Check composer.json is normalized (Composer Normalize PHAR)",
    "normalize-fix": "Normalize composer.json (Composer Normalize PHAR)",
    "phpstan": "Run PHPStan",
    "rector": "Run Rector in dry-run mode with CI rules",
    "rector-fix": "Run Rector in fix mode with CI rules",
    "require-checker": "Run Composer Require Checker (PHAR)",
    "sniffer": "Run PHP_CodeSniffer",
    "sniffer-fix": "Run PHP_CodeSniffer in fix mode",
    "test": "Run all tests",
    "test-coverage": "Run all tests with coverage report",
    "tool:composer-normalize": "Download the latest Composer Normalize PHAR into tools/",
    "tool:composer-require-checker": "Download the latest Composer Require Checker PHAR into tools/",
    "unit": "Run all unit tests",
    "unit-coverage": "Run all unit tests with coverage report"
  }
}
